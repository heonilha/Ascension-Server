{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows (MSVC)",
      "description": "설치된 최신 Visual Studio를 쓴다. 실행 파일: build/windows/bin",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": { "value": "x64", "strategy": "set" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux",
      "displayName": "Linux (GCC, 선택)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux ThreadSanitizer (데이터 경합 검사)",
      "inherits": "linux",
      "cacheVariables": { "CMAKE_CXX_FLAGS": "-fsanitize=thread -g" }
    }
  ],
  "buildPresets": [
    { "name": "windows", "configurePreset": "windows", "configuration": "RelWithDebInfo" },
    { "name": "windows-debug", "configurePreset": "windows", "configuration": "Debug" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "linux-tsan", "configurePreset": "linux-tsan" }
  ]
}
